<h3>予定詳細</h3>

<table>
  <tr>
    <th>ID</th>
    <td><%= @schedule.id %></td>
  </tr>
  <tr>
    <th>タイトル</th>
    <td><%= @schedule.title %></td>
  </tr>
  <tr>
    <th>開始日</th>
    <td><%= @schedule.start_date %></td> 
  </tr>
  <tr>
    <th>終了日</th>
    <td><%= @schedule.end_date %></td>   
  </tr>
  <tr>
    <th>終日</th>
    <td><%= @schedule.is_all_day ? "○" : "" %></td>
  </tr>
  <tr>
    <th>スケジュールメモ</th>
    <td><%= simple_format(@schedule.memo) %></td>
  </tr>
  <tr>
    <th>更新日時</th>
    <td><%= @schedule.updated_at.to_fs(:datetime_jp) %></td>
  </tr>
</table>

<div>
  <ul>
    <li><%= link_to "予定一覧に戻る", schedules_path %></li>
    <li><%= link_to "予定を編集する", edit_schedule_path(@schedule) %></li>
  </ul>
</div>
